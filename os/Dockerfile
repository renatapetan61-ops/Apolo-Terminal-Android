# syntax=docker/dockerfile:1.7
ARG UBUNTU_VERSION=26.04
FROM --platform=linux/arm64 ubuntu:26.04 AS rootfs
ARG UBUNTU_VERSION
ARG TARGETARCH=arm64
ENV DEBIAN_FRONTEND=noninteractive
SHELL ["/bin/bash", "-o", "pipefail", "-c"]

RUN test "${TARGETARCH}" = "arm64" && apt-get update && \
    apt-get install -y --no-install-recommends ca-certificates curl gnupg python3 xz-utils \
      iproute2 iptables nftables kmod e2fsprogs procps psmisc util-linux \
      bash zsh tmux sudo passwd login adduser \
      git wget jq vim-tiny nano less file findutils grep sed gawk \
      build-essential pkg-config cmake ninja-build make gcc g++ \
      python3 python3-pip python3-venv pipx \
      openssh-client openssh-server rsync unzip zip tar gzip bzip2 xz-utils zstd \
      dnsutils iputils-ping net-tools isc-dhcp-client \
      dbus dbus-user-session uidmap slirp4netns fuse-overlayfs && \
    install -d -m 0755 /etc/apt/keyrings && \
    curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg && \
    chmod 0644 /etc/apt/keyrings/docker.gpg && \
    . /etc/os-release && \
    echo "deb [arch=arm64 signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu ${UBUNTU_CODENAME:-$VERSION_CODENAME} stable" > /etc/apt/sources.list.d/docker.list && \
    apt-get update && \
    apt-get install -y --no-install-recommends docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

# Resolve official current Node.js LTS for ARM64 and verify SHA256.
RUN set -eux; \
    NODE_VERSION="$(curl -fsSL https://nodejs.org/dist/index.json | python3 -c 'import json,sys; d=json.load(sys.stdin); print(next(x["version"] for x in d if x.get("lts")))')"; \
    NODE_VERSION="${NODE_VERSION#v}"; \
    NODE_FILE="node-v${NODE_VERSION}-linux-arm64.tar.xz"; \
    curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/${NODE_FILE}"; \
    curl -fsSL "https://nodejs.org/dist/v${NODE_VERSION}/SHASUMS256.txt" -o SHASUMS256.txt; \
    grep " ${NODE_FILE}$" SHASUMS256.txt | sha256sum -c -; \
    tar -xJf "${NODE_FILE}" -C /usr/local --strip-components=1 --no-same-owner; \
    npm install --global corepack; \
    corepack enable; node --version; npm --version; npx --version; corepack --version; \
    rm -f "${NODE_FILE}" SHASUMS256.txt

COPY docker/daemon.json /etc/docker/daemon.json
COPY scripts/apolo-init /sbin/apolo-init
COPY scripts/apolo-kernel-check /usr/local/sbin/apolo-kernel-check
COPY scripts/apolo-useradd /usr/local/sbin/apolo-useradd
COPY scripts/apolo-acceptance-test /usr/local/sbin/apolo-acceptance-test
RUN chmod 0755 /sbin/apolo-init /usr/local/sbin/apolo-kernel-check /usr/local/sbin/apolo-useradd /usr/local/sbin/apolo-acceptance-test && \
    install -d -m 0755 /var/lib/docker /var/lib/containerd /run/lock /run/sshd /workspace /home && \
    printf 'APOLO_ROOTFS_SUITE=%s\n' "${DEBIAN_SUITE}" > /etc/apolo-build-release && \
    printf 'rootfs generated by APOLO Terminal Android\n' > /etc/motd && \
    apt-cache pkgnames | sort -u | wc -l > /etc/apolo-apt-package-index-count && \
    apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

RUN tar --numeric-owner --xattrs --acls \
      --exclude=./out --exclude=./proc --exclude=./sys --exclude=./dev \
      --exclude=./run --exclude=./tmp --exclude=./var/cache/apt/archives \
      -czf /tmp/apolo-rootfs.tar.gz -C / . && \
    mkdir -p /out && mv /tmp/apolo-rootfs.tar.gz /out/rootfs.tar.gz && \
    { echo "architecture=arm64"; echo "guest_os=ubuntu"; echo "ubuntu_version=${UBUNTU_VERSION}"; echo "node_lts=$(node --version)"; echo "docker=$(docker --version)"; echo "compose=$(docker compose version --short)"; echo "apt_index_packages=$(cat /etc/apolo-apt-package-index-count)"; } > /out/build-info.txt

FROM scratch AS export
COPY --from=rootfs /out/ /
